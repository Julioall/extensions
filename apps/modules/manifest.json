{
  "manifest_version": 3,
  "name": "Modules — Moodle",
  "short_name": "Modules",
  "version": "0.3.0",
  "description": "Modules: catálogo e módulos internos do Moodle em modais compactos.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://ead.fieg.com.br/*",
    "https://ead.senai.br/*"
  ],
  "action": {
    "default_title": "Modules — Abrir catálogo no Moodle"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.fieg.com.br/*",
        "https://ead.senai.br/*"
      ],
      "js": [
        "content-v3.js"
      ],
      "css": [
        "modal-v3.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background-v3.js",
    "type": "module"
  }
}
