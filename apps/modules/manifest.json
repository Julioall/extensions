{
  "manifest_version": 3,
  "name": "Modules — Moodle",
  "short_name": "Modules",
  "version": "0.5.2",
  "description": "Gerencia Corrections e Dates, preservando seus scripts, telas e fluxos originais.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://ead.senai.br/*",
    "https://ead.fieg.com.br/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "action": {
    "default_title": "Modules — Catálogo",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "modules-background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.fieg.com.br/*",
        "https://ead.senai.br/*"
      ],
      "js": [
        "radial.js"
      ],
      "css": [
        "radial.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
