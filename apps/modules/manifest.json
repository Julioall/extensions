{
  "manifest_version": 3,
  "name": "Modules — Moodle",
  "short_name": "Modules",
  "version": "0.2.0",
  "description": "Modules: catálogo instalável de componentes Moodle via User Scripts; menu radial dinâmico.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://ead.fieg.com.br/*",
    "https://ead.senai.br/*"
  ],
  "action": {
    "default_title": "Modules — Gerenciar módulos",
    "default_popup": "manager.html"
  },
  "options_page": "manager.html",
  "content_scripts": [
    {
      "matches": [
        "https://ead.fieg.com.br/*",
        "https://ead.senai.br/*"
      ],
      "js": [
        "content-v2.js"
      ],
      "css": [
        "radial.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background-v2.js",
    "type": "module"
  }
}
