{
  "manifest_version": 3,
  "name": "Modules — Moodle",
  "short_name": "Modules",
  "version": "0.4.0",
  "description": "Modules: Corrections completo, Dates com painel original, catálogo mínimo e modais.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://ead.fieg.com.br/*",
    "https://ead.senai.br/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "action": {
    "default_title": "Modules — Abrir catálogo no Moodle"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.fieg.com.br/*",
        "https://ead.senai.br/*"
      ],
      "js": [
        "content-v4.js"
      ],
      "css": [
        "modal-v4.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background-v4.js",
    "type": "module"
  }
}
